    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Fan Control"
      VALUE "ProductName", "Fan Control for IdeaPad 3 14ALC6"
      VALUE "FileVersion", "2.1.0"
      VALUE "ProductVersion", "2.1.0"
      VALUE "OriginalFilename", "FanControl.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
